#pragma once

#include <string>

namespace motus {

/// Project version from CMakeLists.txt.
inline constexpr const char *kVersion = "@PROJECT_VERSION@";

/// Full commit hash, or "unknown" if the tree is not a git checkout -- e.g. a hand-copied
/// directory, which is exactly the situation where provenance matters most.
inline constexpr const char *kCommit = "@MOTUS_COMMIT@";

/// ISO-8601 commit timestamp, or "unknown".
inline constexpr const char *kCommitDate = "@MOTUS_COMMIT_DATE@";

/// How the tree was identified: "git" or "unidentified".
inline constexpr const char *kProvenance = "@MOTUS_PROVENANCE@";

/// One-line build identity, e.g.
/// "motus 0.1.0 (commit 9a28ff5, 2026-08-23T14:10:03+03:00, git)"
///
/// This string reaches the AMQP handshake as the connection identity (see
/// AmqpConnection.hpp), so a broker's connections page names the build that owns each
/// connection -- which matters the day two processes from different builds disagree.
inline std::string versionString()
{
    std::string commit = kCommit;
    if (commit.size() > 7) commit = commit.substr(0, 7);

    return std::string("motus ") + kVersion + " (commit " + commit + ", " + kCommitDate +
           ", " + kProvenance + ")";
}

} // namespace motus
